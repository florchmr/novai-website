---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Icon from '../../components/Icon.astro';
import { WA } from '../../lib/wa';

const title = 'Cómo automatizar el seguimiento de leads sin perder oportunidades';
const description = 'Guía paso a paso para automatizar el seguimiento de leads: qué automatizar, qué herramientas usar, cómo configurarlo y errores que evitar.';

const faqItems = [
  { q: '¿Qué significa automatizar el seguimiento de leads?', a: 'Significa usar tecnología para que el contacto con un potencial cliente ocurra de forma automática en los momentos clave: un email de bienvenida cuando deja sus datos, un recordatorio antes de una reunión, un mensaje de seguimiento si no respondió, una notificación al vendedor cuando el lead hace algo importante. El objetivo es que ningún lead se enfríe por falta de atención.' },
  { q: '¿Cuántos leads se pierden por falta de seguimiento?', a: 'Estudios de la industria indican que entre el 40% y el 60% de los leads nunca reciben un segundo contacto después del primero. En negocios sin CRM ni automatización, el número es aún mayor. La mayoría de las ventas se cierran entre el tercer y el séptimo contacto — si solo hacés uno, estás dejando plata sobre la mesa.' },
  { q: '¿Qué herramientas se usan para automatizar el seguimiento?', a: 'Las más comunes son GoHighLevel (CRM + automatización todo en uno con WhatsApp nativo), HubSpot (CRM con workflows en planes pagos), ActiveCampaign (email + automatización), Make o Zapier (para conectar herramientas entre sí) y la API de WhatsApp Business (mensajes automatizados). La elección depende de tu proceso y tu stack actual.' },
  { q: '¿Puedo automatizar mensajes de WhatsApp?', a: 'Sí. Con la API de WhatsApp Business (integrada en GoHighLevel, o conectada vía Make/Zapier) podés enviar mensajes automáticos de bienvenida, recordatorios de citas, seguimiento post-reunión y secuencias de nutrición. Lo importante es que sean mensajes relevantes y esperados — WhatsApp penaliza el spam con bloqueos.' },
  { q: '¿Automatizar el seguimiento reemplaza al vendedor?', a: 'No. Automatizar el seguimiento se encarga de las tareas repetitivas: enviar el primer email, recordar una reunión, hacer follow-up si no hubo respuesta. El vendedor interviene cuando el lead está calificado y listo para una conversación real. El resultado es que el vendedor habla solo con personas interesadas, en vez de perseguir leads fríos.' },
  { q: '¿Cuánto tarda implementar un sistema de seguimiento automatizado?', a: 'Una automatización básica (email de bienvenida + recordatorio + follow-up) se configura en 1-2 días. Un sistema completo con CRM, WhatsApp, calificación de leads y múltiples secuencias según el comportamiento del contacto tarda entre 2-4 semanas. Lo importante es empezar simple y agregar complejidad con datos.' },
  { q: '¿Cuál es el mejor momento para contactar a un lead?', a: 'Los primeros 5 minutos después de que un lead deja sus datos son críticos — la probabilidad de contacto exitoso cae un 80% después de los primeros 30 minutos. Por eso la automatización es clave: un email o WhatsApp instantáneo garantiza que el lead recibe atención cuando todavía está pensando en tu negocio.' },
];

const pasos = [
  {
    name: 'Mapeá tu proceso de seguimiento actual',
    text: 'Antes de automatizar, escribí qué pasa hoy cuando llega un lead: ¿quién lo contacta? ¿por qué canal? ¿cuántas veces? ¿qué pasa si no responde? Esto te muestra qué pasos son manuales y repetitivos — esos son los que vas a automatizar.',
  },
  {
    name: 'Definí los triggers y las acciones',
    text: 'Un trigger es lo que dispara la automatización (un formulario enviado, una cita agendada, un email abierto). Una acción es lo que pasa después (enviar un email, crear una tarea, notificar al vendedor). Mapeá cada trigger con su acción correspondiente.',
  },
  {
    name: 'Elegí la herramienta según tu stack',
    text: 'Si ya tenés CRM, buscá sus automatizaciones nativas. Si no tenés nada, GoHighLevel es la opción más completa para negocios de servicios en Latinoamérica (CRM + email + WhatsApp + calendario en uno). Si solo necesitás conectar herramientas que ya usás, Make o Zapier resuelven.',
  },
  {
    name: 'Armá la secuencia de seguimiento',
    text: 'Una secuencia básica efectiva: mensaje de bienvenida inmediato → email con información relevante (día 1) → follow-up si no abrió (día 3) → último contacto con llamada a la acción clara (día 7). Adaptá los tiempos y canales según tu negocio.',
  },
  {
    name: 'Configurá la calificación de leads',
    text: 'No todos los leads son iguales. Definí criterios para saber cuáles están listos para hablar con un vendedor (abrieron 3 emails, visitaron la página de precios, respondieron un mensaje) y cuáles necesitan más nutrición. Esto evita que el equipo pierda tiempo con leads fríos.',
  },
  {
    name: 'Activá, medí y ajustá',
    text: 'Lanzá la automatización con un grupo pequeño primero. Medí tasas de apertura, respuesta y conversión. Ajustá los mensajes, los tiempos y los canales según los datos. Una automatización nunca está "terminada" — se optimiza continuamente.',
  },
];

const canales = [
  {
    canal: 'Email',
    mejor: 'Nutrición de largo plazo, envío de recursos, secuencias educativas',
    limitacion: 'Tasas de apertura bajas (15-25%), puede terminar en spam',
  },
  {
    canal: 'WhatsApp',
    mejor: 'Seguimiento inmediato, recordatorios, conversaciones de venta',
    limitacion: 'Requiere API Business, riesgo de bloqueo si es spam',
  },
  {
    canal: 'SMS',
    mejor: 'Recordatorios de citas, confirmaciones, urgencias',
    limitacion: 'Costoso en volumen, percibido como intrusivo si se abusa',
  },
  {
    canal: 'Llamada',
    mejor: 'Leads calificados listos para comprar, high-ticket',
    limitacion: 'No escala, requiere disponibilidad del equipo',
  },
];
---
<Base title={`${title} — NOVAI`} description={description}>
  <Nav />
  <main class="article">

    <section class="section section--dark article__hero">
      <div class="blob blob--green" style="width:420px;height:420px;top:-180px;right:-140px"></div>
      <div class="container">
        <a href="/recursos/" class="btn btn--ghost article__back"><Icon name="arrow-left" size={16} strokeWidth={2} /> Recursos</a>
        <p class="eyebrow" data-reveal>Recursos</p>
        <h1 data-reveal style="--i:1">Cómo automatizar el<br><span class="accent-green">seguimiento de leads.</span></h1>
        <p class="lead article__intro" data-reveal style="--i:2">El seguimiento manual funciona con 10 leads. Con 100, se pierden oportunidades. Así se automatiza sin perder el toque humano.</p>
      </div>
    </section>

    <!-- Qué es -->
    <section class="section section--light">
      <div class="container article__body">
        <h2>El seguimiento es donde se gana (o se pierde) la venta</h2>
        <p>La mayoría de los negocios invierte tiempo y dinero en generar leads — ads, contenido, referidos — pero pierde la mayoría de esas oportunidades por falta de seguimiento. No porque no quieran hacerlo, sino porque <strong>hacerlo manualmente no escala</strong>.</p>
        <p>Un lead que llena un formulario y no recibe respuesta en la primera hora ya se enfrió. Un prospecto que tuvo una buena reunión pero no recibió follow-up en 48 horas, se fue con la competencia. Un contacto que mostró interés hace 2 semanas pero nadie lo volvió a contactar, ya se olvidó de vos.</p>
        <p><strong>Automatizar el seguimiento de leads</strong> significa que cada contacto recibe atención en el momento justo, por el canal correcto, sin que alguien tenga que acordarse de hacerlo. El vendedor interviene solo cuando el lead está listo para una conversación real.</p>

        <div class="article__callout">
          <p><strong>El 80% de las ventas requieren al menos 5 contactos de seguimiento. El 44% de los vendedores se rinden después del primero.</strong> La automatización cierra esa brecha.</p>
        </div>
      </div>
    </section>

    <!-- Pasos -->
    <section class="section section--dark">
      <div class="container">
        <p class="eyebrow" data-reveal>Paso a paso</p>
        <h2 data-reveal style="--i:1">Cómo automatizar el seguimiento en 6 pasos.</h2>
        <div class="article__pasos">
          {pasos.map((paso, i) => (
            <div class="article__paso" data-reveal style={`--i:${i + 2}`}>
              <div class="article__paso-num">{String(i + 1).padStart(2, '0')}</div>
              <div>
                <h3>{paso.name}</h3>
                <p>{paso.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Canales -->
    <section class="section section--light">
      <div class="container article__body">
        <h2>Qué canal usar para cada tipo de seguimiento</h2>
        <p>No todos los canales sirven para todo. Elegir mal el canal es tan dañino como no hacer seguimiento.</p>

        <div class="article__table-wrap">
          <table class="article__table">
            <thead>
              <tr>
                <th>Canal</th>
                <th>Mejor para</th>
                <th>Limitación</th>
              </tr>
            </thead>
            <tbody>
              {canales.map(c => (
                <tr>
                  <td><strong>{c.canal}</strong></td>
                  <td>{c.mejor}</td>
                  <td>{c.limitacion}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p>En Latinoamérica, <strong>WhatsApp + email</strong> es la combinación más efectiva. WhatsApp para lo inmediato y conversacional, email para lo educativo y de largo plazo. Más sobre herramientas en nuestra <a href="/recursos/automatizacion-comercial/" style="color: var(--green);">guía de automatización comercial</a>.</p>
      </div>
    </section>

    <!-- Ejemplo -->
    <section class="section section--dark">
      <div class="container article__body article__body--dark">
        <h2>Ejemplo: secuencia de seguimiento para un negocio de servicios</h2>
        <p>Este es un ejemplo real de cómo se ve una secuencia automatizada desde que un lead llena un formulario hasta el cierre.</p>

        <div class="article__timeline">
          <div class="article__tl-item">
            <span class="article__tl-time">Inmediato</span>
            <div>
              <strong>WhatsApp automático</strong> — "Hola [nombre], recibimos tu consulta. En las próximas horas te vamos a contactar para charlar sobre tu caso."
            </div>
          </div>
          <div class="article__tl-item">
            <span class="article__tl-time">+1 hora</span>
            <div>
              <strong>Email con información</strong> — Presentación de la empresa, casos de éxito, link para agendar una reunión.
            </div>
          </div>
          <div class="article__tl-item">
            <span class="article__tl-time">+24 horas</span>
            <div>
              <strong>Tarea para el vendedor</strong> — Si el lead no agendó, el CRM crea una tarea: "Llamar a [nombre]". El vendedor lo contacta personalmente.
            </div>
          </div>
          <div class="article__tl-item">
            <span class="article__tl-time">+3 días</span>
            <div>
              <strong>Follow-up por email</strong> — "¿Pudiste ver la información? Si tenés dudas, podemos coordinar una llamada rápida."
            </div>
          </div>
          <div class="article__tl-item">
            <span class="article__tl-time">+7 días</span>
            <div>
              <strong>Último contacto</strong> — "Quería saber si sigue siendo un buen momento para avanzar. Si no es ahora, te dejo mi contacto para cuando lo necesites."
            </div>
          </div>
          <div class="article__tl-item">
            <span class="article__tl-time">+14 días</span>
            <div>
              <strong>Pasa a nutrición</strong> — Si no respondió, entra en una secuencia mensual de contenido de valor (no de venta). Se reactiva si interactúa.
            </div>
          </div>
        </div>

        <p>¿Necesitás un CRM para gestionar esto? Leé nuestra <a href="/recursos/crm-para-negocios/" style="color: var(--green);">guía de CRM para negocios de servicios</a>.</p>
      </div>
    </section>

    <!-- CTA -->
    <section class="section section--light">
      <div class="container article__body">
        <div class="article__callout">
          <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">¿Querés automatizar tu seguimiento de leads?</h2>
          <p>En NOVAI configuramos sistemas completos de seguimiento: CRM, WhatsApp, email, calificación de leads y notificaciones al equipo. Todo conectado y midiendo resultados.</p>
          <div style="margin-top: 1.5rem;">
            <a href={WA.proyecto} target="_blank" rel="noopener" class="btn btn--green">Hablemos por WhatsApp <Icon name="arrow-up-right" size={16} strokeWidth={2} /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section--dark">
      <div class="container">
        <p class="eyebrow" data-reveal>Preguntas frecuentes</p>
        <h2 data-reveal style="--i:1">Preguntas sobre seguimiento automatizado.</h2>
        <div class="article__faq article__faq--dark" data-reveal style="--i:2">
          {faqItems.map((item) => (
            <details class="article__faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Seguí leyendo -->
    <section class="section section--light">
      <div class="container">
        <h2 data-reveal>Seguí leyendo</h2>
        <div class="article__related" data-reveal style="--i:1">
          <a href="/recursos/automatizacion-comercial/" class="article__related-card">
            <span class="article__related-tag">Guía</span>
            <h3>Automatización comercial</h3>
            <p>Qué es, cuándo la necesitás y cómo implementarla.</p>
          </a>
          <a href="/recursos/crm-para-negocios/" class="article__related-card">
            <span class="article__related-tag">Guía</span>
            <h3>CRM para negocios de servicios</h3>
            <p>Cómo elegir el CRM correcto e implementarlo sin drama.</p>
          </a>
          <a href="/recursos/funnel-de-ventas/" class="article__related-card">
            <span class="article__related-tag">Guía</span>
            <h3>Funnel de ventas: la guía práctica</h3>
            <p>Qué es, cómo funciona y cómo armar uno que convierta.</p>
          </a>
        </div>
      </div>
    </section>

  </main>
</Base>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  author: { '@type': 'Organization', name: 'NOVAI', url: 'https://agencianovai.com' },
  publisher: { '@type': 'Organization', name: 'NOVAI', url: 'https://agencianovai.com' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://agencianovai.com/recursos/automatizar-seguimiento-leads/' },
})} />
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
})} />
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Cómo automatizar el seguimiento de leads',
  description: 'Guía paso a paso para automatizar el seguimiento de leads en un negocio de servicios, desde mapear el proceso hasta medir resultados.',
  step: pasos.map(p => ({
    '@type': 'HowToStep',
    name: p.name,
    text: p.text,
  })),
})} />

<style>
  .article__hero { padding-top: 10rem; padding-bottom: var(--space-section); }
  .article__hero h1 { margin-bottom: 1.5rem; }
  .article__intro { max-width: 48rem; }
  .article__back { margin-bottom: 2rem; font-size: 0.8rem; }

  .article__body { max-width: 52rem; }
  .article__body h2 { margin-bottom: 1.5rem; }
  .article__body p { color: var(--ink-muted); line-height: 1.8; margin-bottom: 1rem; }
  .article__body--dark p { color: var(--paper-muted); }
  .article__body--dark h2 { color: var(--paper); }

  .article__callout {
    margin: 2rem 0; padding: 2rem; border-radius: var(--radius-card);
    background: var(--bg-light); border-left: 4px solid var(--green);
  }
  .article__callout p { color: var(--ink); margin-bottom: 0; }

  /* Pasos */
  .article__pasos { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 2.5rem; }
  .article__paso {
    display: flex; gap: 1.5rem; padding: 2rem;
    border: 1px solid var(--line-dark); border-radius: var(--radius-card);
  }
  .article__paso-num { font-size: 1.5rem; font-weight: 700; color: var(--green); min-width: 2.5rem; }
  .article__paso h3 { margin-bottom: 0.5rem; }
  .article__paso p { color: var(--paper-muted); line-height: 1.7; font-size: 0.95rem; }

  /* Tabla */
  .article__table-wrap { overflow-x: auto; margin: 2rem 0; }
  .article__table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .article__table th { text-align: left; padding: 1rem; border-bottom: 2px solid var(--green); color: var(--green); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .article__table td { padding: 1rem; border-bottom: 1px solid var(--line-light); color: var(--ink-muted); line-height: 1.6; }

  /* Timeline */
  .article__timeline { display: flex; flex-direction: column; gap: 0; margin: 2rem 0; }
  .article__tl-item {
    display: flex; gap: 1.5rem; padding: 1.5rem 0;
    border-bottom: 1px solid var(--line-dark);
  }
  .article__tl-item:last-child { border-bottom: none; }
  .article__tl-time {
    min-width: 6rem; font-size: 0.8rem; font-weight: 700; color: var(--green);
    padding-top: 0.15rem;
  }
  .article__tl-item div { color: var(--paper-muted); line-height: 1.7; font-size: 0.95rem; }
  .article__tl-item strong { color: var(--paper); }

  /* FAQ */
  .article__faq { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 2rem; }
  .article__faq-item { border: 1px solid var(--line-light); border-radius: var(--radius-card); overflow: hidden; }
  .article__faq--dark .article__faq-item { border-color: var(--line-dark); }
  .article__faq-item summary {
    padding: 1.25rem 1.5rem; cursor: pointer; font-weight: 600; font-size: 0.95rem;
    list-style: none; display: flex; justify-content: space-between; align-items: center;
    transition: background var(--dur) var(--ease);
  }
  .article__faq-item summary:hover { background: rgba(255,255,255,0.05); }
  .article__faq-item summary::after { content: '+'; font-size: 1.25rem; color: var(--green); font-weight: 300; }
  .article__faq-item[open] summary::after { content: '−'; }
  .article__faq-item p { padding: 0 1.5rem 1.25rem; color: var(--paper-muted); line-height: 1.8; font-size: 0.95rem; }

  /* Seguí leyendo */
  .article__related { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 2rem; }
  .article__related-card {
    display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem;
    border: 1px solid var(--line-light); border-radius: var(--radius-card);
    text-decoration: none; color: var(--ink);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .article__related-card:hover { border-color: var(--green); transform: translateY(-2px); }
  .article__related-tag { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--green); font-weight: 600; }
  .article__related-card h3 { font-size: 1rem; }
  .article__related-card p { color: var(--ink-muted); font-size: 0.85rem; line-height: 1.6; }

  .section--light .eyebrow .label { color: var(--ink-muted); }
  .section--light h2 { color: var(--ink); }
  .section--light .lead { color: var(--ink-muted); }

  @media (max-width: 900px) {
    .article__hero { padding-top: 7rem; }
    .article__paso { flex-direction: column; gap: 0.75rem; }
    .article__tl-item { flex-direction: column; gap: 0.5rem; }
    .article__related { grid-template-columns: 1fr; }
  }
</style>
