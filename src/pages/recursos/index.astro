---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Icon from '../../components/Icon.astro';
import { WA } from '../../lib/wa';

const title = 'Recursos — NOVAI';
const description = 'Guías, comparativas y recursos sobre infraestructura digital, CRM, automatización y marketing. Pensados para que tomes mejores decisiones tecnológicas.';

const recursos = [
  {
    title: 'Automatización comercial: qué es, cuándo la necesitás y cómo implementarla',
    description: 'Guía completa sobre automatización de procesos comerciales. Qué se puede automatizar, cuándo tiene sentido hacerlo y cómo implementarlo.',
    href: '/recursos/automatizacion-comercial/',
    tag: 'Guía',
  },
  {
    title: 'Funnel de ventas: qué es, cómo funciona y cómo armar uno que convierta',
    description: 'Guía práctica sobre funnels de venta. Qué son, qué etapas tienen, qué herramientas usar y los errores más comunes al implementarlos.',
    href: '/recursos/funnel-de-ventas/',
    tag: 'Guía',
  },
  {
    title: 'CRM para negocios de servicios: cómo elegir e implementar el correcto',
    description: 'Qué buscar en un CRM, cómo implementarlo, errores comunes y qué opciones existen según tu tipo de negocio.',
    href: '/recursos/crm-para-negocios/',
    tag: 'Guía',
  },
  {
    title: 'Cómo automatizar el seguimiento de leads sin perder oportunidades',
    description: 'Guía paso a paso para automatizar el seguimiento de leads: qué automatizar, qué herramientas usar y cómo configurarlo.',
    href: '/recursos/automatizar-seguimiento-leads/',
    tag: 'Guía',
  },
  {
    title: 'WhatsApp Business para ventas: cómo usarlo de forma profesional',
    description: 'API vs app, automatización, integración con CRM y errores que evitar al vender por WhatsApp.',
    href: '/recursos/whatsapp-business-ventas/',
    tag: 'Guía',
  },
  {
    title: 'GoHighLevel vs HubSpot vs alternativas: cuál elegir según tu negocio',
    description: 'Comparativa honesta entre GoHighLevel, HubSpot, ActiveCampaign, Kommo y Clientify. Precios reales, diferencias clave y para quién sirve cada uno.',
    href: '/recursos/ghl-vs-hubspot/',
    tag: 'Comparativa',
  },
];
---
<Base title={title} description={description}>
  <Nav />
  <main class="recursos">

    <section class="section section--dark recursos__hero">
      <div class="blob blob--purple" style="width:420px;height:420px;top:-180px;right:-140px"></div>
      <div class="container">
        <p class="eyebrow" data-reveal>Recursos</p>
        <h1 data-reveal style="--i:1">Guías y comparativas<br><span class="accent-green">para decidir mejor.</span></h1>
        <p class="lead recursos__intro" data-reveal style="--i:2">Contenido pensado para que entiendas qué herramientas y procesos necesita tu negocio — sin humo, sin complicaciones.</p>
      </div>
    </section>

    <section class="section section--light">
      <div class="container">
        <div class="recursos__grid">
          {recursos.map((item, i) => (
            <a href={item.href} class="recursos__card" data-reveal style={`--i:${i + 1}`}>
              <span class="recursos__tag">{item.tag}</span>
              <h2>{item.title}</h2>
              <p>{item.description}</p>
              <span class="recursos__link">Leer artículo <Icon name="arrow-right" size={16} strokeWidth={2} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--dark recursos__cta-section">
      <div class="container recursos__cta-inner">
        <h2 data-reveal>¿Necesitás ayuda para elegir?</h2>
        <p class="lead" data-reveal style="--i:1">Contanos qué problema querés resolver y te orientamos sin compromiso.</p>
        <a href={WA.proyecto} target="_blank" rel="noopener" class="btn btn--green" data-reveal style="--i:2">Hablemos por WhatsApp <Icon name="arrow-up-right" size={16} strokeWidth={2} /></a>
      </div>
    </section>

  </main>
</Base>

<style>
  .recursos__hero { padding-top: 10rem; padding-bottom: var(--space-section); }
  .recursos__hero h1 { margin-bottom: 1.5rem; }
  .recursos__intro { max-width: 48rem; }

  .recursos__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }

  .recursos__card {
    display: flex; flex-direction: column; gap: 0.75rem;
    padding: 2rem; border-radius: var(--radius-card);
    background: var(--paper); border: 1px solid var(--line-light);
    text-decoration: none; color: var(--ink);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .recursos__card:hover {
    border-color: var(--green);
    box-shadow: 0 8px 24px -12px rgba(62, 242, 107, 0.15);
    transform: translateY(-2px);
  }

  .recursos__tag {
    display: inline-block; width: fit-content;
    padding: 0.25rem 0.75rem; border-radius: var(--radius);
    background: var(--bg-dark); color: var(--green);
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
  }

  .recursos__card h2 { font-size: 1.25rem; line-height: 1.4; }
  .recursos__card p { color: var(--ink-muted); line-height: 1.7; font-size: 0.95rem; flex: 1; }

  .recursos__link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    color: var(--ink); font-size: 0.85rem; font-weight: 600;
    margin-top: 0.5rem;
  }

  .recursos__cta-section { text-align: center; }
  .recursos__cta-inner { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }

  @media (max-width: 900px) {
    .recursos__hero { padding-top: 7rem; }
    .recursos__grid { grid-template-columns: 1fr; }
  }

  .section--light .eyebrow .label { color: var(--ink-muted); }
  .section--light h2 { color: var(--ink); }
  .section--light .lead { color: var(--ink-muted); }
</style>
