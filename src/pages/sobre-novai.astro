---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Icon from '../components/Icon.astro';
import { WA, CALENDAR_URL } from '../lib/wa';

const enfoque = [
  {
    title: 'Problema primero',
    text: 'Antes de elegir una herramienta, entendemos qué está frenando al negocio. Cada proyecto empieza con un diagnóstico real.',
  },
  {
    title: 'Sistema antes que herramienta',
    text: 'No pensamos "¿qué herramienta podemos usar?" sino "¿qué tiene que pasar en este proceso y qué infraestructura lo permite?"',
  },
  {
    title: 'Proporcional al momento',
    text: 'La solución debe ser proporcional al problema, al volumen y al momento del negocio. No sobreautomatizamos ni sobrecomplicamos.',
  },
  {
    title: 'Marketing primero, tecnología después',
    text: 'La tecnología responde a un objetivo de marketing, ventas u operaciones. Nunca al revés.',
  },
];

---
<Base title="Sobre NOVAI — Infraestructura digital para marketing y ventas" description="NOVAI conecta marketing, tecnología y operaciones. Construimos los sistemas digitales que hacen que el marketing y las ventas funcionen: funnels, CRM, automatizaciones e inteligencia artificial.">
  <Nav />
  <main class="about">

    <!-- Hero -->
    <section class="section section--dark about__hero">
      <div class="blob blob--purple" style="width:520px;height:520px;top:-200px;right:-180px"></div>
      <div class="container">
        <p class="eyebrow" data-reveal>Sobre NOVAI</p>
        <h1 data-reveal style="--i:1">Construimos la infraestructura digital<br><span class="accent-green">detrás de tu marketing.</span></h1>
        <p class="lead about__intro" data-reveal style="--i:2">NOVAI es una agencia que conecta marketing, tecnología y operaciones para que cada parte del sistema trabaje como una sola. No somos una agencia de marketing tradicional ni un estudio de desarrollo. Nuestro foco está en construir y conectar los sistemas que hacen que el marketing y las ventas funcionen.</p>
      </div>
    </section>

    <!-- Qué hacemos -->
    <section class="section section--dark">
      <div class="container about__what">
        <div>
          <p class="eyebrow" data-reveal>Qué hacemos</p>
          <h2 data-reveal style="--i:1">El marketing genera oportunidades.<br><span class="accent-green">Nosotros construimos lo que las hace avanzar.</span></h2>
        </div>
        <div class="about__what-text" data-reveal style="--i:2">
          <p>Captación, seguimiento, agenda, conversión, comunicación, gestión — todo eso es infraestructura digital. Y es lo que construimos.</p>
          <p>Trabajamos en la intersección entre marketing, tecnología y operaciones. El resultado son sistemas donde cada pieza está conectada y cada proceso puede avanzar sin depender de intervención manual constante.</p>
        </div>
      </div>
    </section>

    <!-- Enfoque -->
    <section class="section section--light">
      <div class="container">
        <p class="eyebrow" data-reveal><span class="label">Cómo trabajamos</span></p>
        <h2 data-reveal style="--i:1">Nuestro enfoque.</h2>
        <div class="about__grid">
          {enfoque.map((item, i) => (
            <div class="about__card" data-reveal style={`--i:${i + 2}`}>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Capacidades -->
    <section class="section section--dark">
      <div class="container">
        <p class="eyebrow" data-reveal>Con qué trabajamos</p>
        <h2 data-reveal style="--i:1">Capacidades.</h2>
        <div class="about__caps" data-reveal style="--i:2">
          <div class="about__cap">
            <h3>Conversión</h3>
            <p>Funnels, landing pages, websites, sistemas de agenda, checkouts y páginas de registro.</p>
          </div>
          <div class="about__cap">
            <h3>Operaciones</h3>
            <p>CRM, pipelines, gestión y seguimiento de leads, segmentación, workflows y automatización de procesos comerciales.</p>
          </div>
          <div class="about__cap">
            <h3>Integración</h3>
            <p>Conexión entre herramientas: APIs, Zapier, Make, sincronización de información entre CRM, formularios, agenda, email y WhatsApp.</p>
          </div>
          <div class="about__cap">
            <h3>Inteligencia</h3>
            <p>Agentes de IA, respuestas automáticas, clasificación de leads y procesamiento de información integrado a procesos existentes.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Quién está detrás -->
    <section class="section section--light">
      <div class="container about__founder">
        <div>
          <p class="eyebrow" data-reveal><span class="label">Quién está detrás</span></p>
          <h2 data-reveal style="--i:1">Marketing + tecnología,<br>desde el día uno.</h2>
        </div>
        <div class="about__founder-text" data-reveal style="--i:2">
          <p>NOVAI nace de más de 7 años de experiencia construyendo sistemas digitales para negocios reales. Detrás hay una Licenciada en Marketing que entiende tanto la estrategia comercial como la implementación técnica.</p>
          <p>Esa combinación es lo que define a NOVAI: no pensamos solo en la herramienta ni solo en la campaña. Pensamos en cómo conectar las dos cosas para que el negocio avance.</p>
        </div>
      </div>
    </section>

    <!-- Para quién -->
    <section class="section section--dark">
      <div class="container about__audience">
        <div>
          <p class="eyebrow" data-reveal>Para quién trabajamos</p>
          <h2 data-reveal style="--i:1">Negocios que ya venden<br>y necesitan mejorar su infraestructura.</h2>
        </div>
        <div class="about__audience-list" data-reveal style="--i:2">
          <div>
            <h3>Infoproductores</h3>
            <p>Cursos, programas, membresías y productos digitales que necesitan sistemas para captar, convertir y gestionar clientes.</p>
          </div>
          <div>
            <h3>Expertos y consultores</h3>
            <p>Profesionales, coaches y vendedores de servicios de alto valor que necesitan optimizar su proceso comercial.</p>
          </div>
          <div>
            <h3>Negocios de servicios</h3>
            <p>Empresas que generan leads y necesitan mejorar seguimiento, agenda y conversión.</p>
          </div>
          <div>
            <h3>Agencias</h3>
            <p>Agencias que mantienen la estrategia y necesitan un partner tecnológico para la implementación: funnels, CRM, automatizaciones, integraciones y sistemas personalizados.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stack -->
    <section class="section section--light">
      <div class="container">
        <p class="eyebrow" data-reveal><span class="label">Stack tecnológico</span></p>
        <h2 data-reveal style="--i:1">Las herramientas son el medio, no el fin.</h2>
        <p class="lead" data-reveal style="--i:2">Elegimos la tecnología después de entender el problema. Estas son algunas de las herramientas con las que trabajamos habitualmente.</p>
        <div class="about__stack" data-reveal style="--i:3">
          <span>GoHighLevel</span>
          <span>WhatsApp Business</span>
          <span>Make</span>
          <span>n8n</span>
          <span>Zapier</span>
          <span>HubSpot</span>
          <span>Shopify</span>
          <span>Stripe</span>
          <span>Mercado Pago</span>
          <span>Meta Ads</span>
          <span>Google Ads</span>
          <span>Notion</span>
          <span>Calendly</span>
          <span>Airtable</span>
          <span>Typeform</span>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section section--dark about__cta-section">
      <div class="blob blob--green" style="width:380px;height:380px;bottom:-120px;left:-100px"></div>
      <div class="blob blob--purple" style="width:280px;height:280px;top:-80px;right:-60px"></div>
      <div class="container about__cta-inner">
        <h2 data-reveal>¿Tenés un proyecto en mente?</h2>
        <p class="lead" data-reveal style="--i:1">Contanos qué necesita tu negocio y veamos cómo construir el sistema que lo haga avanzar.</p>
        <div class="about__cta-buttons" data-reveal style="--i:2">
          <a href={WA.proyecto} target="_blank" rel="noopener" class="btn btn--green">Hablemos por WhatsApp <Icon name="arrow-up-right" size={16} strokeWidth={2} /></a>
          <a href="/agendar" class="btn btn--ghost">Agendar videollamada <Icon name="arrow-right" size={16} strokeWidth={2} /></a>
        </div>
      </div>
    </section>

  </main>
</Base>

<style>
  .about__hero { padding-top: 10rem; padding-bottom: var(--space-section); }
  .about__hero h1 { margin-bottom: 1.5rem; }
  .about__intro { max-width: 52rem; }

  /* Qué hacemos */
  .about__what { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  .about__what-text { display: flex; flex-direction: column; gap: 1rem; }
  .about__what-text p { color: var(--paper-muted); line-height: 1.8; }

  /* Enfoque */
  .about__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: 2.5rem; }
  .about__card {
    padding: 2rem; border-radius: var(--radius-card);
    background: var(--paper); border: 1px solid var(--line-light);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .about__card:hover { border-color: var(--green); box-shadow: 0 8px 24px -12px rgba(62, 242, 107, 0.15); }
  .about__card h3 { margin-bottom: 0.75rem; }
  .about__card p { color: var(--ink-muted); line-height: 1.7; font-size: 0.95rem; }

  /* Capacidades */
  .about__caps { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: 2.5rem; }
  .about__cap { padding: 2rem; border: 1px solid var(--line-dark); border-radius: var(--radius-card); }
  .about__cap h3 { color: var(--green); margin-bottom: 0.75rem; }
  .about__cap p { color: var(--paper-muted); line-height: 1.7; font-size: 0.95rem; }

  /* Founder */
  .about__founder { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  .about__founder-text { display: flex; flex-direction: column; gap: 1rem; }
  .about__founder-text p { color: var(--ink-muted); line-height: 1.8; }

  /* Audience */
  .about__audience { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  .about__audience-list { display: flex; flex-direction: column; gap: 2rem; }
  .about__audience-list h3 { margin-bottom: 0.5rem; }
  .about__audience-list p { color: var(--paper-muted); line-height: 1.7; font-size: 0.95rem; }

  /* Stack */
  .about__stack { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .about__stack span {
    padding: 0.5rem 1.1rem; border-radius: var(--radius);
    border: 1px solid var(--line-light); font-size: 0.85rem; font-weight: 500;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .about__stack span:hover { border-color: var(--green); color: var(--green); }

  /* CTA */
  .about__cta-section { text-align: center; }
  .about__cta-inner { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .about__cta-buttons { display: flex; gap: 1.5rem; margin-top: 0.5rem; }

  @media (max-width: 900px) {
    .about__hero { padding-top: 7rem; }
    .about__what { grid-template-columns: 1fr; gap: 2rem; }
    .about__grid { grid-template-columns: 1fr; }
    .about__caps { grid-template-columns: 1fr; }
    .about__founder { grid-template-columns: 1fr; gap: 2rem; }
    .about__audience { grid-template-columns: 1fr; gap: 2rem; }
    .about__cta-buttons { flex-wrap: wrap; justify-content: center; }
  }

  /* light sections text */
  .section--light .eyebrow .label { color: var(--ink-muted); }
  .section--light h2 { color: var(--ink); }
  .section--light .lead { color: var(--ink-muted); }
</style>
