---
import Icon from './Icon.astro';
const steps = [
  { icon: 'plug-zap', title: 'Conectar', text: 'Herramientas e información trabajando juntas.' },
  { icon: 'workflow', title: 'Automatizar', text: 'Menos tareas manuales. Más continuidad.' },
  { icon: 'trending-up', title: 'Convertir', text: 'Procesos pensados para hacer avanzar oportunidades.' },
] as const;
---
<section id="sistema" class="section section--light">
  <div class="blob blob--purple" style="width:460px;height:460px;top:-180px;right:8%"></div>
  <div class="blob blob--green" style="width:320px;height:320px;top:-40px;right:-100px"></div>

  <div class="container">
    <p class="eyebrow" data-reveal><span class="label">Lo que pasa después del clic</span></p>

    <div class="section-head">
      <h2 data-reveal style="--i:1">Tu marketing genera el lead.<br><span class="accent-purple">El sistema hace el resto.</span></h2>
      <p class="lead" data-reveal style="--i:2">Captar es solo el comienzo. Diseñamos lo que sucede después para que cada oportunidad pueda avanzar.</p>
    </div>

    <!-- Flujo: lead → 3 pasos → cliente. La línea se dibuja al entrar y un pulso la recorre. -->
    <div class="flow" data-reveal style="--i:3">
      <div class="flow__end">
        <span class="flow__pill">Lead</span>
        <span class="small">Tu marketing</span>
      </div>
      <div class="flow__line" aria-hidden="true"><span class="flow__pulse"></span></div>
      <ol class="flow__steps">
        {steps.map((s, i) => (
          <li class="flow__step" style={`--i:${i + 4}`} data-reveal>
            <span class="flow__node"><Icon name={s.icon} size={22} /></span>
            <h3>{s.title}</h3>
            <p class="small">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="flow__end flow__end--out">
        <span class="flow__pill flow__pill--green">Cliente</span>
        <span class="small">Tu sistema</span>
      </div>
    </div>
  </div>
</section>

<style>
  .flow {
    position: relative;
    display: grid; grid-template-columns: auto 1fr auto; gap: 2.5rem; align-items: start;
    padding-top: var(--space-block); border-top: 1px solid var(--line-light);
  }
  .flow__end { display: flex; flex-direction: column; gap: 0.5rem; align-items: center; text-align: center; padding-top: 0.35rem; }
  .flow__pill {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 0.55rem 1rem; border-radius: var(--radius); border: 1px solid var(--purple); color: var(--purple);
  }
  .flow__pill--green { border-color: var(--green); background: var(--green); color: var(--ink); }

  /* línea horizontal detrás de los nodos */
  .flow__line {
    position: absolute; left: 5.5rem; right: 6.5rem; top: calc(var(--space-block) + 1.5rem);
    height: 2px; background: linear-gradient(90deg, var(--purple), var(--green));
    transform: scaleX(0); transform-origin: left; transition: transform 1.2s var(--ease) 0.3s;
  }
  .flow.is-visible .flow__line { transform: scaleX(1); }
  .flow__pulse {
    position: absolute; top: 50%; left: 0; width: 10px; height: 10px; border-radius: 50%;
    background: var(--paper); box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.25), 0 0 18px var(--purple);
    transform: translate(-50%, -50%);
    animation: travel 4s var(--ease) 1.4s infinite;
    opacity: 0;
  }
  @keyframes travel { 0% { left: 0; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { left: 100%; opacity: 0; } }

  .flow__steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .flow__step { display: flex; flex-direction: column; gap: 0.5rem; align-items: center; text-align: center; }
  .flow__node {
    position: relative; z-index: 1;
    display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%;
    background: var(--paper); border: 1px solid var(--line-light);
    box-shadow: 0 8px 24px -12px rgba(124, 58, 237, 0.4);
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .flow__step:hover .flow__node { transform: translateY(-3px); border-color: var(--purple); }
  .flow__node :global(.icon) { width: 22px; height: 22px; }
  .flow__step h3 { margin-top: 0.75rem; }
  .flow__step .small { max-width: 16rem; }

  @media (max-width: 900px) {
    .flow { grid-template-columns: 1fr; gap: 2rem; }
    .flow__line, .flow__end .small { display: none; }
    .flow__end { flex-direction: row; justify-content: center; }
    .flow__end { justify-content: flex-start; }
    .flow__steps { position: relative; grid-template-columns: 1fr; gap: 1.5rem; }
    /* línea vertical que une los nodos en mobile */
    .flow__steps::before { content: ''; position: absolute; left: 1.5rem; top: 1.5rem; bottom: 1.5rem; width: 1px; background: linear-gradient(180deg, var(--purple), var(--green)); }
    .flow__step { flex-direction: row; text-align: left; align-items: flex-start; flex-wrap: wrap; gap: 0.25rem 1rem; }
    .flow__step h3 { margin-top: 0.6rem; }
    .flow__step .small { flex-basis: 100%; padding-left: 4rem; max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) { .flow__pulse { animation: none; } .flow__line { transform: none; } }
</style>
