---
import Icon from './Icon.astro';
// ponytail: href="#" hasta que existan las páginas de cada proyecto
const projects = [
  { title: 'Event Operations', desc: 'Plataforma para centralizar ventas, generar accesos únicos y controlar el ingreso a eventos.', badge: 'Solución personalizada', href: '/proyectos/event-ops', image: '/projects/event-ops/portada.png' },
  { title: 'Product Customization', desc: 'Sistema conectado con Shopify que transforma cada pedido en una experiencia de personalización y organiza automáticamente la información para producción.', badge: 'E-commerce + Automatización', href: '/proyectos/product-custom', image: '/projects/product-custom/portada.png' },
  { title: 'Digital Education Ecosystem', desc: 'Ecosistema digital completo para captar leads, convertirlos en clientes y entregar una formación online de manera automatizada.', badge: 'Funnel + CRM + Automatización', href: '/proyectos/digital-education', image: '/projects/digital-education/portada.png' },
];
---
<section id="proyectos" class="section section--light">
  <div class="blob blob--green" style="width:380px;height:380px;bottom:-200px;left:-160px"></div>

  <div class="container">
    <p class="eyebrow" data-reveal><span class="label">Proyectos</span></p>

    <div class="section-head">
      <h2 data-reveal style="--i:1">Sistemas diseñados<br>para <span class="accent-purple">casos reales.</span></h2>
      <p class="lead" data-reveal style="--i:2">Cada proyecto es una cadena de piezas conectadas. Así se ven.</p>
    </div>

    <ol class="projects">
      {projects.map((p, i) => (
        <li data-reveal style={`--i:${i + 3}`}>
          <a href={p.href} class={`project ${p.image ? 'project--hero' : ''}`} data-spotlight>
            {p.image && <img src={p.image} alt={p.title} class="project__img" loading="lazy" />}
            <div class="project__content">
              <div class="project__head">
                <span class="project__num">Proyecto 0{i + 1}</span>
                <span class="project__link">Ver proyecto <Icon name="arrow-up-right" size={16} strokeWidth={2} /></span>
              </div>
              <h3>{p.title}</h3>
              <p class="project__desc">{p.desc}</p>
              <span class="project__badge">{p.badge}</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .projects { display: grid; gap: 1rem; }
  .project {
    display: flex; flex-direction: column; gap: 1.25rem;
    padding: 2rem 2.25rem;
    background: var(--paper); border: 1px solid var(--line-light); border-radius: var(--radius-card);
    cursor: pointer; --spot: rgba(124, 58, 237, 0.1);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .project:hover, .project:focus-visible { border-color: var(--purple); transform: translateY(-2px); box-shadow: 0 16px 40px -24px rgba(124, 58, 237, 0.45); }
  .project__head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .project__num { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--purple); }
  .project__link {
    display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted);
    transition: color var(--dur) var(--ease);
  }
  .project__link :global(.icon) { color: currentColor; transition: transform var(--dur) var(--ease); }
  .project:hover .project__link { color: var(--purple); }
  .project:hover .project__link :global(.icon) { transform: translate(2px, -2px); }
  .project h3 { font-size: 1.4rem; }

  /* Card hero con imagen */
  .project--hero {
    flex-direction: row; overflow: hidden; padding: 0;
    background: var(--bg-dark); border-color: var(--line-dark);
    --spot: rgba(62, 242, 107, 0.08);
  }
  .project--hero:hover, .project--hero:focus-visible { border-color: var(--green); box-shadow: 0 16px 40px -24px rgba(62, 242, 107, 0.35); }
  .project__img { width: 55%; min-height: 420px; object-fit: cover; display: block; flex-shrink: 0; }
  .project__content { display: flex; flex-direction: column; gap: 1.25rem; padding: 2rem 2.25rem; justify-content: center; }
  .project--hero .project__num { color: var(--green); }
  .project--hero .project__link { color: var(--paper-muted); }
  .project--hero:hover .project__link { color: var(--green); }
  .project--hero h3 { color: var(--paper); font-size: 1.6rem; }
  .project__desc { font-size: 0.9rem; color: var(--ink-muted); line-height: 1.6; }
  .project--hero .project__desc { color: var(--paper-muted); }
  .project__badge {
    display: inline-block; width: fit-content;
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.4rem 0.85rem; border-radius: var(--radius);
    border: 1px solid var(--line-light); color: var(--ink-muted); background: var(--bg-light);
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .project:hover .project__badge { border-color: var(--purple); color: var(--purple); background: rgba(124, 58, 237, 0.06); }
  .project--hero .project__badge { border-color: var(--line-dark); color: var(--paper-muted); background: rgba(255,255,255,0.05); }
  .project--hero:hover .project__badge { border-color: var(--green); color: var(--green); background: rgba(62, 242, 107, 0.08); }
  @media (max-width: 700px) {
    .project { padding: 1.5rem; }
    .project--hero { flex-direction: column; padding: 0; }
    .project__img { width: 100%; }
    .project__content { padding: 1.5rem; }
  }
</style>
