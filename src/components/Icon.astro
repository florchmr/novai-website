---
// Iconos de Lucide (ISC) inyectados inline en build, sin JS en cliente.
import target from 'lucide-static/icons/target.svg?raw';
import cpu from 'lucide-static/icons/cpu.svg?raw';
import workflow from 'lucide-static/icons/workflow.svg?raw';
import scanSearch from 'lucide-static/icons/scan-search.svg?raw';
import route from 'lucide-static/icons/route.svg?raw';
import layers from 'lucide-static/icons/layers.svg?raw';
import trendingUp from 'lucide-static/icons/trending-up.svg?raw';
import chartColumn from 'lucide-static/icons/chart-column.svg?raw';
import plugZap from 'lucide-static/icons/plug-zap.svg?raw';
import sparkle from 'lucide-static/icons/sparkle.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';

const icons = {
  target, cpu, workflow, 'scan-search': scanSearch, route, layers,
  'trending-up': trendingUp, 'chart-column': chartColumn, 'plug-zap': plugZap,
  sparkle, 'arrow-up-right': arrowUpRight, 'arrow-right': arrowRight,
};
export type IconName = keyof typeof icons;

interface Props { name: IconName; class?: string; size?: number; strokeWidth?: number }
const { name, class: cls = 'icon', size = 24, strokeWidth = 1.5 } = Astro.props;

const svg = icons[name]
  .replace(/<!--.*?-->\s*/s, '')
  .replace(/class="[^"]*"/, `class="${cls}"`)
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${strokeWidth}"`)
  .replace('<svg', '<svg aria-hidden="true" focusable="false"');
---
<Fragment set:html={svg} />
