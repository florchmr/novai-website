---
import { SITE } from '../lib/site';
import { WA_NUMBER } from '../lib/wa';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(SITE.ogImage, Astro.site);

// JSON-LD: quién es la agencia, qué hace, cómo contactarla. Ayuda a Google y a los buscadores con IA.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  url: Astro.site?.href,
  description: SITE.description,
  image: ogImage.href,
  foundingDate: String(SITE.founded),
  areaServed: SITE.areaServed,
  knowsAbout: ['Marketing digital', 'Funnels', 'CRM', 'Automatización', 'GoHighLevel', 'Integraciones', 'Agentes de IA', 'WhatsApp Business'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: `+${WA_NUMBER}`,
    availableLanguage: 'es',
    url: `https://wa.me/${WA_NUMBER}`,
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Soluciones',
    itemListElement: SITE.services.map(s => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s } })),
  },
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{SITE.title}</title>
<meta name="description" content={SITE.description} />
<link rel="canonical" href={canonical.href} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="theme-color" content="#0a0a14" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph / redes -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:url" content={canonical.href} />
<meta property="og:title" content={SITE.title} />
<meta property="og:description" content={SITE.description} />
<meta property="og:image" content={ogImage.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="NOVAI — Marketing + Technology" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={SITE.title} />
<meta name="twitter:description" content={SITE.description} />
<meta name="twitter:image" content={ogImage.href} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
