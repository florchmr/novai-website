---
import { WA } from '../lib/wa';
import Icon from './Icon.astro';
// ponytail: la agenda también va a WhatsApp; cambiar por Calendly/GHL cuando exista
const WHATSAPP = WA.proyecto;
const AGENDA = WA.agenda;
---
<section id="contacto" class="section section--light cta-wrap">
  <div class="container">
    <div class="cta section--dark" data-reveal>
      <div class="blob blob--purple" style="width:360px;height:360px;left:-120px;top:-140px"></div>
      <div class="blob blob--green" style="width:280px;height:280px;right:-100px;bottom:-140px"></div>
      <div class="cta__text">
        <p class="eyebrow"><span class="label">¿Tenés un proyecto en mente?</span></p>
        <h2>Veamos qué necesita <span class="accent-green">tu sistema.</span></h2>
        <p class="cta__desc">Contanos qué querés construir, mejorar o conectar. Vemos tu caso y definimos juntos el próximo paso.</p>
      </div>
      <div class="cta__actions">
        <a href={WHATSAPP} target="_blank" rel="noopener" class="btn btn--green">Hablemos por WhatsApp <Icon name="arrow-up-right" size={16} strokeWidth={2} /></a>
        <a href={AGENDA} target="_blank" rel="noopener" class="btn btn--outline">Agendar una videollamada <Icon name="arrow-right" size={16} strokeWidth={2} /></a>
      </div>
    </div>
  </div>
</section>

<footer class="footer section--light">
  <div class="container footer__inner">
    <span>© {new Date().getFullYear()} NOVAI</span>
    <span>Agencia de marketing + tecnología</span>
  </div>
</footer>

<style>
  .cta-wrap { padding-block: 0 4rem; }
  .cta {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 3rem; align-items: center;
    padding: 3.5rem; border-radius: 12px;
  }
  .cta > :not(.blob) { position: relative; z-index: 1; }
  .cta__text { display: flex; flex-direction: column; gap: 1rem; }
  .cta__desc { font-size: 1.05rem; line-height: 1.6; color: var(--paper); opacity: 0.75; max-width: 36rem; text-wrap: pretty; }
  .cta .eyebrow { margin-bottom: 0; }
  .cta h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); }
  .cta__actions { display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start; justify-self: end; }
  .footer { padding-block: 1.75rem; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); border-top: 1px solid var(--line-light); }
  .footer__inner { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  @media (max-width: 900px) {
    .cta { grid-template-columns: 1fr; padding: 2.25rem 1.75rem; gap: 2rem; }
    .cta__actions { justify-self: start; }
  }
</style>
